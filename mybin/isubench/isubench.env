# isubench の問題ごとの設定。競技開始後に埋める。調べ方は .agents/skills/isubench/SKILL.md の「準備」。
# 右のコメントは ISUCON14 (isuride) で使った値。

# アプリへの proxy_pass を書いた nginx の設定ファイルと、その転送先の文字列 (ファイル内で全部置き換わる)
ISUBENCH_NGINX_CONF=                 # /etc/nginx/sites-enabled/isuride.conf
ISUBENCH_UPSTREAM=                   # localhost:8080

# 再生の送り先 (nginx が 443 だけなら https、80 なら http)。Host は空なら録画時のまま
ISUBENCH_TARGET=https://127.0.0.1
ISUBENCH_HOST=

# CPU 秒を測る systemd サービス (カンマ区切り) と、それが動いているホスト (local 以外は ssh する)
ISUBENCH_SERVICES=                   # isuride-go,isuride-matcher,mysql,nginx
ISUBENCH_HOSTS=local

# アプリが呼ぶ外部サービスの代わりのスタブ (POST は 204、GET は [] を返す) と、
# 録画に残った公式ベンチ側の URL の置き換え (old=new を空白区切り)
ISUBENCH_STUB=                       # 127.0.0.1:12346
ISUBENCH_REWRITE=                    # http://192.168.0.10:12345=http://127.0.0.1:12346

# 既定で足りないときだけ書く
# ISUBENCH_BARRIER='^(/api)?/initialize'   これが終わるまで後続を送らない
# ISUBENCH_ID_REGEX='[0-9A-Za-z_-]{20,}'   サーバーが発行する文字列の ID・トークンの形
# ISUBENCH_SKIP='^/api/internal/'          録画しないパス
# ISUBENCH_SPEED=4
